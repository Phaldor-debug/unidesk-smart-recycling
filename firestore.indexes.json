{
  "indexes": [
    {
      "//": "Puan geçmişi: kullanıcının puanı ALINMIŞ oturumlarını çeker. İki eşitlik filtresi (uid + pointsClaimed) birlikte kullanıldığı için Firestore bileşik indeks ister.",
      "collectionGroup": "sessions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "pointsClaimed", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Sıralama tablosu: bir ayın skorlarını puana göre sıralar (period + points).",
      "collectionGroup": "monthly_scores",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "period", "order": "ASCENDING" },
        { "fieldPath": "points", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Ana sayfa: kullanıcının yarıda kalmış oturumunu bulur (uid + status).",
      "collectionGroup": "sessions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Kodlarım ekranı: kullanıcının kullanılmamış haklarını çeker (uid + status).",
      "collectionGroup": "redemptions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "uid", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Yemekhane paneli: koddan aktif hakkı bulur (code + status).",
      "collectionGroup": "redemptions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "code", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
