rules_version = '2';

// Ünidesk Geri Dönüşüm — Firestore güvenlik kuralları.
//
// Genel ilke: hiçbir şey varsayılan olarak açık değildir. Her koleksiyon
// için sadece burada açıkça izin verilen okuma/yazma işlemleri geçerlidir.
//
// ÖNEMLİ NOT (bilinen sınır, gelecekte çözülecek):
// Puan/oturum güncellemeleri şu an istemci (öğrencinin telefonu) tarafından
// yapılıyor çünkü henüz ESP32/sunucu tarafı bir doğrulayıcı (Cloud Function)
// yok. Bu kurallar "sadece kendi kaydını değiştirebilirsin" ile başkalarının
// verisine erişimi engeller, ama teknik olarak bilgili bir kullanıcının
// KENDİ puanını/oturumunu Firestore'a doğrudan yazarak "hile yapması"
// hâlâ mümkündür. Bunun kalıcı çözümü, puan/oturum yazmalarını bir Cloud
// Function veya güvenilir bir sunucuya taşımaktır — bu, admin paneliyle
// birlikte planlanan bir sonraki güvenlik iyileştirmesi.
service cloud.firestore {
  match /databases/{database}/documents {

    // OKUMA: giriş yapmış herkese açık — global sıralama tablosu bunu
    // gerektiriyor. Bu yüzden kullanıcı belgesinde SADECE herkese
    // gösterilebilir alanlar tutuluyor (uid, displayName, points);
    // e-posta bilerek Firebase Auth tarafında bırakıldı, buraya
    // yazılmıyor (bkz. AppUser sınıfındaki açıklama).
    //
    // YAZMA: yalnızca kişinin kendi belgesi.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Bir atık atma oturumu sadece onu başlatan kullanıcı tarafından
    // okunabilir/güncellenebilir. create'de yeni belgenin uid'sinin
    // isteği yapan kullanıcıyla eşleşmesi zorunlu (başkası adına
    // oturum açılamaz).
    match /sessions/{sessionId} {
      // Yeni oturum SIFIRDAN başlamak zorunda: kimse hazır sayaçla veya
      // "puanı alınmış" işaretiyle oturum açamaz.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.depositedCount == 0
                    && request.resource.data.pointsClaimed == false;

      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;

      // Sahibi güncelleyebilir AMA: pointsClaimed bir kez true olduysa
      // asla false'a döndürülemez ve sahibi değiştirilemez. Bu olmadan
      // kullanıcı bayrağı sıfırlayıp AYNI oturumdan sınırsız kez puan
      // toplayabiliyordu.
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && !(resource.data.pointsClaimed == true
                         && request.resource.data.pointsClaimed == false);

      allow delete: if false; // Oturum geçmişi silinmesin.
    }

    // Bir hak (redemption) sadece onu talep eden kullanıcı tarafından
    // oluşturulabilir. Okuma GİRİŞ YAPMIŞ HERKESE açık — yemekhane
    // panelinin koddan hakkı bulabilmesi için gerekli (henüz ayrı bir
    // personel rolü/girişi yok, bkz. üstteki not).
    match /redemptions/{redemptionId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'active';

      allow read: if request.auth != null;

      // Güncelleme SADECE "active -> used" tek yönlü geçişidir ve başka
      // hiçbir alan değiştirilemez. Bu kısıt olmadan bir öğrenci kendi
      // kullanılmış kodunu tekrar 'active' yapıp AYNI kodla sınırsız
      // hak kullanabiliyordu; ya da başkasının kodunu/tutarını
      // değiştirebiliyordu.
      allow update: if request.auth != null
                    && resource.data.status == 'active'
                    && request.resource.data.status == 'used'
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.code == resource.data.code
                    && request.resource.data.rewardId == resource.data.rewardId
                    && request.resource.data.rewardTitle == resource.data.rewardTitle;

      allow delete: if false;
    }

    // Ödül kataloğu: giriş yapmış herkes okuyabilir (Ödüller ekranı için).
    // YAZMA YOK — kataloğu SADECE Firebase Console'dan (admin yetkisiyle,
    // bu kurallardan muaf olarak) düzenliyoruz. İstemciden biri ödül
    // ekleyip kendine bedava puan kazandıramaz.
    match /rewards/{rewardId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
